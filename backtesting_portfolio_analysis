# ============================================================
# 13. DAILY RETURNS FROM PORTFOLIO VALUES
# ============================================================

comparison_returns = (
    comparison_values
    .pct_change()
    .dropna()
)


# ============================================================
# 14. PERFORMANCE STATISTICS
# ============================================================

def performance_statistics(
    strategy_returns,
    value_series,
    risk_free_rate=0.0
):
    """
    Calculate realized out-of-sample performance statistics.
    """

    # Annualized arithmetic return
    annual_return = (
        strategy_returns.mean()
        * TRADING_DAYS
    )

    # Annualized volatility
    annual_volatility = (
        strategy_returns.std()
        * np.sqrt(TRADING_DAYS)
    )

    # Sharpe ratio
    sharpe = (
        annual_return
        - risk_free_rate
    ) / annual_volatility

    # Total compounded return
    total_return = (
        value_series.iloc[-1]
        / value_series.iloc[0]
        - 1
    )

    # Running historical maximum
    running_max = (
        value_series.cummax()
    )

    # Drawdown
    drawdown = (
        value_series
        / running_max
        - 1
    )

    # Maximum drawdown
    max_drawdown = (
        drawdown.min()
    )

    final_value = (
        value_series.iloc[-1]
    )

    return {
        "Annual Return":
            annual_return,

        "Volatility":
            annual_volatility,

        "Sharpe":
            sharpe,

        "Total Return":
            total_return,

        "Max Drawdown":
            max_drawdown,

        "Final Value":
            final_value
    }


# ============================================================
# 15. FULL PERFORMANCE COMPARISON
# ============================================================

statistics = {}

for strategy in comparison_values.columns:

    statistics[strategy] = (
        performance_statistics(
            comparison_returns[strategy],
            comparison_values[strategy],
