        f"{weight:.2%}"
    )


# ============================================================
# 7. STATIC OUT-OF-SAMPLE PORTFOLIO
# ============================================================

test_prices = prices.loc[
    BACKTEST_START:
]

static_value = holding_period_value(
    test_prices,
    static_weights,
    INITIAL_VALUE
)


# ============================================================
# 8. ROLLING ANNUAL RE-OPTIMIZATION
# ============================================================

backtest_years = sorted(
    prices.loc[
        BACKTEST_START:
    ].index.year.unique()
)

rolling_parts = []

rolling_weight_history = []

current_value = INITIAL_VALUE


for year in backtest_years:

    # --------------------------------------------------------
    # Define rolling training window
    # --------------------------------------------------------

    training_start_year = (
        year - LOOKBACK_YEARS
    )

    training_start = (
        f"{training_start_year}-01-01"
    )

    training_end = (
        f"{year - 1}-12-31"
    )

    training_returns = returns.loc[
        training_start:training_end
    ]

    if training_returns.empty:
        continue


    # --------------------------------------------------------
    # Optimize using only information available in the past
    # --------------------------------------------------------

    year_weights = optimize_max_sharpe(
        training_returns
    )


    # --------------------------------------------------------
    # Store weights
    # --------------------------------------------------------

    weight_record = {
        "Year": year
    }

    for ticker, weight in zip(
        returns.columns,
        year_weights
    ):
        weight_record[ticker] = weight

    rolling_weight_history.append(
        weight_record
    )


    # --------------------------------------------------------
    # Get prices for the year being tested
    # --------------------------------------------------------

    year_prices = prices[
        prices.index.year == year
    ]

    if year_prices.empty:
        continue


    # --------------------------------------------------------
    # Rebalance at the beginning of the year
    # and hold until year-end
    # --------------------------------------------------------

    year_value = holding_period_value(
        year_prices,
        year_weights,
        current_value
    )


    # Avoid duplicate year-boundary points
    if len(rolling_parts) > 0:

        year_value = (
            year_value.iloc[1:]
        )


    rolling_parts.append(
        year_value
    )


    # Carry final wealth into the next year
    current_value = (
        year_value.iloc[-1]
    )


# Join all yearly periods
rolling_value = pd.concat(
    rolling_parts
)


# Convert rolling weights to DataFrame
rolling_weights = pd.DataFrame(
    rolling_weight_history
)

rolling_weights = (
    rolling_weights
    .set_index("Year")
)


# ============================================================
# 9. PRINT AND SAVE ROLLING WEIGHT HISTORY
# ============================================================

