# ============================================================
# 10. EQUAL-WEIGHT ANNUAL REBALANCING
# ============================================================

equal_weights = (
    np.ones(len(TICKERS))
    / len(TICKERS)
)

equal_parts = []

current_value = INITIAL_VALUE


for year in backtest_years:

    year_prices = prices[
        prices.index.year == year
    ]

    if year_prices.empty:
        continue

    # Reset allocation to 25% in each asset
    # at the beginning of every year.
    year_value = holding_period_value(
        year_prices,
        equal_weights,
        current_value
    )

    if len(equal_parts) > 0:

        year_value = (
            year_value.iloc[1:]
        )

    equal_parts.append(
        year_value
    )

    current_value = (
        year_value.iloc[-1]
    )


equal_value = pd.concat(
    equal_parts
)


# ============================================================
# 11. SPY BUY-AND-HOLD BENCHMARK
# ============================================================

spy_prices = test_prices["SPY"]

spy_value = (
    INITIAL_VALUE
    * spy_prices
    / spy_prices.iloc[0]
)


# ============================================================
# 12. ALIGN ALL PORTFOLIO VALUE SERIES
# ============================================================

comparison_values = pd.concat(
    {
        "Rolling Optimized":
            rolling_value,

        "Static Optimized":
            static_value,

        "Equal Weight":
            equal_value,

        "SPY":
