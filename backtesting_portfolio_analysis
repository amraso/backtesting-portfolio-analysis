# ============================================================
# CONFIGURATION
# ============================================================

TICKERS = ["SPY", "QQQ", "TLT", "GLD"]

START_DATE = "2001-01-01"

BACKTEST_START = "2007-01-01"

LOOKBACK_YEARS = 5

TRADING_DAYS = 252

# Educational simplification.
# Can later be replaced with a realistic risk-free benchmark.
RISK_FREE_RATE = 0.00

INITIAL_VALUE = 100.0

