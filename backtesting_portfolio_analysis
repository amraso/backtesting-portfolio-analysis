# ============================================================
# 3. PORTFOLIO FUNCTIONS
# ============================================================

def annualized_portfolio_return(
    weights,
    mean_returns
):
    """
    Calculate annualized expected portfolio return.
    """

    return (
        weights
        @ mean_returns
        * TRADING_DAYS
    )


def annualized_portfolio_volatility(
    weights,
    covariance_matrix
):
    """
    Calculate annualized portfolio volatility.
    """

    return np.sqrt(
        weights
        @ covariance_matrix
        @ weights
        * TRADING_DAYS
    )


def negative_sharpe_ratio(
    weights,
    mean_returns,
    covariance_matrix,
    risk_free_rate
):
    """
    Return the negative Sharpe ratio.

    scipy.optimize.minimize() performs minimization,
    therefore maximizing Sharpe is equivalent to
    minimizing -Sharpe.
    """

    portfolio_return = (
        annualized_portfolio_return(
            weights,
            mean_returns
        )
    )

    portfolio_volatility = (
        annualized_portfolio_volatility(
            weights,
            covariance_matrix
        )
    )

    sharpe = (
        portfolio_return
        - risk_free_rate
    ) / portfolio_volatility

    return -sharpe


# ============================================================
# 4. MAXIMUM-SHARPE OPTIMIZER
# ============================================================

def optimize_max_sharpe(
    training_returns
):
    """
    Find maximum-Sharpe portfolio weights using
    only the supplied training-period returns.

    Constraints:
    - weights sum to 1
    - no short selling
    """

    mean_returns = (
        training_returns.mean()
    )

    covariance = (
        training_returns.cov()
    )

    n_assets = len(
        training_returns.columns
    )

    initial_weights = (
        np.ones(n_assets)
        / n_assets
    )

    bounds = tuple(
        (0, 1)
        for _ in range(n_assets)
    )

    constraints = (
        {
            "type": "eq",
            "fun": lambda weights:
                np.sum(weights) - 1
        },
    )

    result = minimize(
        negative_sharpe_ratio,
        initial_weights,
        args=(
            mean_returns,
            covariance,
            RISK_FREE_RATE
        ),
        method="SLSQP",
        bounds=bounds,
        constraints=constraints,
        options={
            "ftol": 1e-12,
            "maxiter": 1000
        }
    )

    if not result.success:
        raise RuntimeError(
            "Optimization failed: "
            + result.message
        )

    return result.x


# ============================================================
# 5. BUY-AND-HOLD VALUE FOR ONE PERIOD
# ============================================================

def holding_period_value(
    period_prices,
    weights,
    initial_value
):
    """
    Allocate capital according to the specified weights
    at the beginning of a period.

    The resulting number of shares is then held without
    rebalancing until the end of that period.
    """

    start_prices = (
        period_prices.iloc[0]
    )

    capital_per_asset = (
        initial_value
        * weights
    )

    shares = (
        capital_per_asset
        / start_prices.to_numpy()
    )

    portfolio_value = (
        period_prices.to_numpy()
        @ shares
    )

    return pd.Series(
        portfolio_value,
        index=period_prices.index
    )


# ============================================================
# 6. STATIC OPTIMIZATION
# ============================================================

# Use all available data before 2021 to build one portfolio.
# Those weights remain frozen throughout the backtest.

static_train_returns = returns.loc[
    START_DATE:"2020-12-31"
]

static_weights = optimize_max_sharpe(
    static_train_returns
)

print(
