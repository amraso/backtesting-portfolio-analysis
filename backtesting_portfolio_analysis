# ============================================================
# 3. PORTFOLIO FUNCTIONS
# ============================================================

def annualized_portfolio_return(weights, mean_returns):
    """
    Annualized expected portfolio return.
    """
    return weights @ mean_returns * TRADING_DAYS


def annualized_portfolio_volatility(weights, covariance_matrix):
    """
    Annualized portfolio volatility.
    """
    return np.sqrt(
        weights @ covariance_matrix @ weights * TRADING_DAYS
    )


def negative_sharpe_ratio(
    weights,
    mean_returns,
    covariance_matrix,
    risk_free_rate
):
    """
    Negative Sharpe ratio.

    scipy.optimize.minimize() minimizes a function,
    therefore maximizing Sharpe is equivalent to
    minimizing -Sharpe.
    """

    portfolio_return = annualized_portfolio_return(
        weights,
        mean_returns
    )

    portfolio_volatility = annualized_portfolio_volatility(
        weights,
        covariance_matrix
    )

    if portfolio_volatility <= 0:
        return 1e10

    sharpe = (
        portfolio_return - risk_free_rate
    ) / portfolio_volatility

    return -sharpe


# ============================================================
# 4. MAXIMUM-SHARPE OPTIMIZER
# ============================================================

def optimize_max_sharpe(training_returns):
    """
    Find the long-only maximum-Sharpe portfolio using only
    the supplied historical training data.

    Constraints:
    - weights sum to 1
    - no short selling
    """

    mean_returns = training_returns.mean()
    covariance = training_returns.cov()

    n_assets = len(training_returns.columns)

    initial_weights = np.ones(n_assets) / n_assets

    bounds = tuple(
        (0, 1)
        for _ in range(n_assets)
    )

    constraints = (
        {
            "type": "eq",
            "fun": lambda weights: np.sum(weights) - 1
        },
    )

    result = minimize(
        negative_sharpe_ratio,
        initial_weights,
        args=(
            mean_returns,
            covariance,
            RISK_FREE_RATE
        ),
        method="SLSQP",
        bounds=bounds,
        constraints=constraints,
        options={
            "ftol": 1e-12,
            "maxiter": 1000
        }
    )

    if not result.success:
        raise RuntimeError(
            "Optimization failed: "
            + result.message
        )

    return result.x


# ============================================================
# 5. BUY-AND-HOLD PORTFOLIO VALUE
# ============================================================

def holding_period_value(
    period_prices,
    weights,
    initial_value
):
    """
    Invest initial_value according to the chosen weights
    at the first price observation and hold the resulting
    number of shares throughout the period.
    """

    start_prices = period_prices.iloc[0]

    capital_per_asset = (
        initial_value * weights
    )

    shares = (
        capital_per_asset
        / start_prices.to_numpy()
    )

    portfolio_value = (
        period_prices.to_numpy()
        @ shares
    )

    return pd.Series(
        portfolio_value,
        index=period_prices.index
    )


# ============================================================
# 6. YEARLY HOLDING PERIOD WITH PREVIOUS-CLOSE ANCHOR
# ============================================================

def yearly_holding_period(
    prices,
    year,
    weights,
    initial_value,
    first_period=False
):
    """
    Rebalance at the beginning of a calendar year and hold
    until year-end.

    For years after the first backtest year, the previous
    trading day's closing prices are included as an anchor.
    This preserves the return between the previous year-end
    and the first trading day of the new year.
    """

    year_prices = prices[
        prices.index.year == year
    ]

    if year_prices.empty:
        return pd.Series(dtype=float)

    if first_period:
        return holding_period_value(
            year_prices,
            weights,
            initial_value
        )

    previous_prices = prices[
        prices.index < year_prices.index[0]
    ]

    if previous_prices.empty:
        return holding_period_value(
            year_prices,
            weights,
            initial_value
        )

    anchor = previous_prices.iloc[[-1]]

    period_prices = pd.concat(
        [anchor, year_prices]
    )

    period_value = holding_period_value(
        period_prices,
        weights,
        initial_value
    )

    # Remove the anchor itself while preserving the first
    # trading day's return.
    return period_value.iloc[1:]


# ============================================================
# 7. GENERIC ROLLING BACKTEST
# ============================================================

def rolling_backtest_with_lookback(
    prices,
    returns,
    backtest_start,
    lookback_years,
    initial_value,
    save_weights=False
):
    """
    Rolling maximum-Sharpe backtest.

    At the beginning of each year:

    1. Use the previous N years as training data.
    2. Estimate mean returns and covariance.
    3. Optimize the maximum-Sharpe portfolio.
    4. Rebalance.
    5. Hold until year-end.

    Returns
    -------
    portfolio_value : pd.Series
        Portfolio value through time.

    weights_history : pd.DataFrame or None
        Annual optimized weights when save_weights=True.
    """

    backtest_years = sorted(
        prices.loc[backtest_start:].index.year.unique()
    )

    portfolio_parts = []
    weight_history = []

    current_value = initial_value
    first_valid_period = True

    for year in backtest_years:

        training_start = (
            f"{year - lookback_years}-01-01"
        )

        training_end = (
            f"{year - 1}-12-31"
        )

        training_returns = returns.loc[
            training_start:training_end
        ]

        # Require approximately a complete lookback window.
        minimum_observations = (
            200 * lookback_years
        )

        if len(training_returns) < minimum_observations:
            continue

        year_weights = optimize_max_sharpe(
            training_returns
        )

        if save_weights:

            weight_record = {
                "Year": year
            }

            for ticker, weight in zip(
                returns.columns,
                year_weights
            ):
                weight_record[ticker] = weight

            weight_history.append(
                weight_record
            )

        year_value = yearly_holding_period(
            prices=prices,
            year=year,
            weights=year_weights,
            initial_value=current_value,
            first_period=first_valid_period
        )

        if year_value.empty:
            continue

        portfolio_parts.append(
            year_value
        )

        current_value = (
            year_value.iloc[-1]
        )

        first_valid_period = False

    if not portfolio_parts:
        return pd.Series(dtype=float), None

    portfolio_value = pd.concat(
        portfolio_parts
    )

    portfolio_value = portfolio_value[
        ~portfolio_value.index.duplicated(
            keep="first"
        )
    ]

    if save_weights:

        weights_history = pd.DataFrame(
            weight_history
        )

        if not weights_history.empty:
            weights_history = (
                weights_history
                .set_index("Year")
            )

    else:
        weights_history = None

    return (
        portfolio_value,
        weights_history
    )


# ============================================================
# 8. PERFORMANCE STATISTICS
# ============================================================

def performance_statistics(
    strategy_returns,
    value_series,
    risk_free_rate=0.0
):
    """
    Calculate realized portfolio performance statistics.
    """

    annual_return = (
        strategy_returns.mean()
        * TRADING_DAYS
    )

    annual_volatility = (
        strategy_returns.std()
        * np.sqrt(TRADING_DAYS)
    )

    if annual_volatility > 0:

        sharpe = (
            annual_return
            - risk_free_rate
        ) / annual_volatility

    else:
        sharpe = np.nan

    total_return = (
        value_series.iloc[-1]
        / value_series.iloc[0]
        - 1
    )

    running_max = (
        value_series.cummax()
    )

    drawdown = (
        value_series
        / running_max
        - 1
    )

    max_drawdown = (
        drawdown.min()
    )

    final_value = (
        value_series.iloc[-1]
    )

    return {
        "Annual Return":
            annual_return,

        "Volatility":
            annual_volatility,

        "Sharpe":
            sharpe,

        "Total Return":
            total_return,

        "Max Drawdown":
            max_drawdown,

        "Final Value":
            final_value
    }


